{
  "name": "skyvexsoftware/stratos-logbook-api",
  "description": "Stratos Logbook API — phpVMS 7 module exposing pilot flight history.",
  "type": "phpvms-module",
  "license": "MIT",
  "authors": [
    { "name": "Skyvex Software Pty Ltd", "homepage": "https://skyvexsoftware.com" }
  ],
  "autoload": {
    "psr-4": {
      "Modules\\StratosLogbook\\": ""
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Modules\\StratosLogbook\\Tests\\": "tests/",
      "App\\": "tests/stubs/App/",
      "Modules\\StratosCore\\": "tests/stubs/Modules/StratosCore/"
    }
  },
  "require": {
    "php": "^8.2"
  },
  "require-dev": {
    "pestphp/pest": "^2.0",
    "orchestra/testbench": "^8.0",
    "laravel/pint": "^1.29"
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    },
    "platform": {
      "php": "8.2.0"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
